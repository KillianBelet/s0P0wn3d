# Configuration du client et du serveur TLS.
# Format : CLE=valeur (une par ligne). Les lignes commençant par # sont ignorées.
# Un argument en ligne de commande est prioritaire sur ce fichier.

# --- Réseau ---
# IP à laquelle le CLIENT se connecte.
# ATTENTION : cette IP doit figurer dans le certificat serveur (voir gen-certs.ps1).
SERVER_IP=127.0.0.1
# IP sur laquelle le SERVEUR écoute (0.0.0.0 = toutes les cartes réseau).
SERVER_BIND_IP=127.0.0.1
# Port commun au client et au serveur.
SERVER_PORT=12345

# --- Certificats ---
CA_CERT=certs/ca.crt
SERVER_CERT=certs/server.crt
SERVER_KEY=certs/server.key
CLIENT_CERT=certs/client.crt
CLIENT_KEY=certs/client.key
