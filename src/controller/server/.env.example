# .env — Configuration C2 / Implant
# Copier en ".env" et adapter. Ne jamais committer .env (contient les chemins des clés).

# --- Réseau ---
# IP du C2 server (utilisée par l'implant pour se connecter).
# DOIT figurer dans le SAN du certificat serveur (voir gen-certs.sh).
SERVER_IP=192.168.56.104

# IP sur laquelle le C2 écoute (0.0.0.0 = toutes les interfaces).
SERVER_BIND_IP=0.0.0.0

# Port commun C2 + implant.
SERVER_PORT=4444

# --- Certificats ---
CA_CERT=certs/ca.crt
SERVER_CERT=certs/server.crt
SERVER_KEY=certs/server.key
CLIENT_CERT=certs/client.crt
CLIENT_KEY=certs/client.key
